{
  "name": "tropy-plugin-autropy",
  "productName": "Autropy",
  "version": "0.1.0-alpha.1",
  "description": "Multimodal AI analysis for Tropy: suggests tags and descriptions with researcher review.",
  "author": "Anita Lucchesi",
  "homepage": "https://github.com/lucchesia/tropy-plugin-autropy",
  "main": "index.js",
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "watch": "rollup -c rollup.config.mjs --watch"
  },
  "hooks": {
    "export": true
  },
  "options": [
    {
      "field": "model",
      "label": "Model ID (e.g. gemini-2.5-flash, gpt-4o, claude-opus-4-6)",
      "type": "string",
      "default": "",
      "required": true
    },
    {
      "field": "apiKey",
      "label": "API Key",
      "type": "string",
      "default": "",
      "required": true
    },
    {
      "field": "port",
      "label": "Tropy API Port",
      "type": "number",
      "default": 2029,
      "required": false
    },
    {
      "field": "suggestMetadata",
      "label": "Suggest Metadata",
      "type": "bool",
      "default": false,
      "required": false
    },
    {
      "field": "prompt",
      "label": "Custom Prompt",
      "type": "string",
      "default": "",
      "required": false
    }
  ],
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "rollup": "^4.0.0",
    "rollup-plugin-license": "^3.6.0"
  }
}
